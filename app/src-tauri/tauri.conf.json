{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "equalizer",
  "version": "0.1.0",
  "identifier": "com.github.akiraak.equalizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Equalizer",
        "width": 760,
        "height": 380,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
