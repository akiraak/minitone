{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "equalizer",
  "version": "0.1.0",
  "identifier": "com.github.akiraak.equalizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Equalizer",
        "width": 600,
        "height": 190,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "akiraak",
    "shortDescription": "Treble, Bass and Volume knobs for all Windows audio",
    "license": "MIT",
    "resources": {
      "../../apo/build/equalizer_apo.dll": "apo/equalizer_apo.dll",
      "../../apo/scripts/install-apo.ps1": "apo/install-apo.ps1",
      "../../apo/scripts/uninstall-apo.ps1": "apo/uninstall-apo.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
